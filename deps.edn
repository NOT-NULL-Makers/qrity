{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps
   {org.clojure/test.check {:mvn/version "1.1.3"}}
   :main-opts ["-m" "qrity.test-runner"]}

  :cljs-test
  {:extra-paths ["test"]
   :extra-deps
   {org.clojure/clojurescript {:mvn/version "1.12.145"}
    org.clojure/test.check {:mvn/version "1.1.3"}}
   :main-opts ["-m" "qrity.node-test-runner"]}

  :interop-jvm
  {:extra-paths ["test"]
   :main-opts ["-m" "qrity.interop-emit"]}

  :interop-cljs
  {:extra-paths ["test"]
   :extra-deps
   {org.clojure/clojurescript {:mvn/version "1.12.145"}}
   :main-opts ["-m" "qrity.node-interop-runner"]}}}
